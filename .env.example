APP_NAME="AZURION FACTURADOR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,sunat,audit
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=azurion_facturador
DB_USERNAME=azurion
DB_PASSWORD=azurion
DB_SCHEMA=public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=180

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REDIS_QUEUE=default
HORIZON_PREFIX=azurion_horizon:

TENANT_HEADER=X-Tenant-RUC
TENANT_SCHEMA_PREFIX=empresa_
TENANT_STORAGE_DISK=tenants
FACTURADOR_ARTIFACT_URL_TTL_MINUTES=30
SUNAT_TIMEOUT=30
SUNAT_BETA_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_PROD_URL=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService
SUNAT_GUIA_BETA_URL=https://e-beta.sunat.gob.pe/ol-ti-itemision-guia-gem-beta/billService
SUNAT_GUIA_PROD_URL=https://e-guiaremision.sunat.gob.pe/ol-ti-itemision-guia-gem/billService
SUNAT_BETA_QUEUE=sunat-beta
SUNAT_PRODUCTION_QUEUE=sunat-production
AUTH_DISABLED=false
HMAC_REQUIRED_WITH_API_KEY=true
HMAC_SIGNATURE_HEADER=X-Signature
HMAC_TIMESTAMP_HEADER=X-Timestamp
HMAC_NONCE_HEADER=X-Nonce
HMAC_SIGNATURE_VERSION_HEADER=X-Signature-Version
HMAC_TOLERANCE_SECONDS=300
HMAC_NONCE_TTL_SECONDS=600
# Integracion recomendada Azurion -> Facturador. El client ID identifica y el secret firma.
AZURION_INTEGRATION_CLIENT_ID=azurion-core
AZURION_INTEGRATION_SECRET=
AZURION_INTEGRATION_PREVIOUS_SECRET=
AZURION_INTEGRATION_CLIENT_ID_HEADER=X-Client-Id
AZURION_INTEGRATION_ALLOW_LEGACY_API_KEY=false
# Compatibilidad temporal con el protocolo anterior.
AZURION_INTEGRATION_API_KEY=
AZURION_CALLBACK_ENABLED=true
AZURION_CALLBACK_URL=http://127.0.0.1:8080/api/v1/facturador/callback/ventas
AZURION_CALLBACK_URL_VENTAS=http://127.0.0.1:8080/api/v1/facturador/callback/ventas
AZURION_CALLBACK_URL_GUIAS=http://127.0.0.1:8080/api/v1/facturador/callback/guias
AZURION_CALLBACK_URL_NOTAS_CREDITO=http://127.0.0.1:8080/api/v1/facturador/callback/notas-credito
AZURION_CALLBACK_URL_NOTAS_DEBITO=http://127.0.0.1:8080/api/v1/facturador/callback/notas-debito
AZURION_CALLBACK_URL_DOCUMENTOS=http://127.0.0.1:8080/api/v1/facturador/callback/documentos
AZURION_CALLBACK_API_KEY=
AZURION_CALLBACK_SECRET=
AZURION_CALLBACK_HEADER_API_KEY=X-API-Key
AZURION_CALLBACK_HEADER_SIGNATURE=X-Signature
AZURION_CALLBACK_HEADER_TIMESTAMP=X-Timestamp
AZURION_CALLBACK_HEADER_NONCE=X-Nonce
AZURION_CALLBACK_CONNECT_TIMEOUT_SECONDS=3
AZURION_CALLBACK_TIMEOUT_SECONDS=8

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
